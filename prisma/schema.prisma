generator client {
  provider      = "prisma-client-js"
  // "native" para desenvolvimento; debian-openssl-3.0.x cobre a imagem Linux usada na hospedagem.
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  // Dono do sistema: acesso total.
  OWNER
  // Cliente revendedor: só vê e troca o link das plaquinhas atribuídas a ele.
  CLIENT
}

model AdminUser {
  id           String              @id @default(uuid()) @db.Uuid
  email        String              @unique @db.VarChar(254)
  passwordHash String              @map("password_hash")
  role         UserRole            @default(OWNER)
  name         String?             @db.VarChar(120)
  // Conta desativada não consegue entrar (as sessões abertas são encerradas).
  active       Boolean             @default(true)
  createdAt    DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime            @updatedAt @map("updated_at") @db.Timestamptz(3)
  sessions     Session[]
  plates       Plate[]
  changes      DestinationChange[]

  @@index([role])
  @@map("admin_users")
}

model Session {
  id        String    @id @default(uuid()) @db.Uuid
  // Hash SHA-256 do token do cookie; o token em si nunca é gravado.
  tokenHash String    @unique @map("token_hash") @db.Char(64)
  csrfToken String    @map("csrf_token") @db.VarChar(64)
  adminId   String    @map("admin_id") @db.Uuid
  admin     AdminUser @relation(fields: [adminId], references: [id], onDelete: Cascade)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(3)

  @@index([adminId])
  @@index([expiresAt])
  @@map("sessions")
}

model Plate {
  id             String              @id @default(uuid()) @db.Uuid
  // Identificador público e permanente usado em /r/:code. Imutável (trigger no banco).
  code           String              @unique @db.VarChar(32)
  // Nulo enquanto a plaquinha do lote ainda não foi atribuída a um cliente.
  businessName   String?             @map("business_name") @db.VarChar(120)
  internalName   String              @map("internal_name") @db.VarChar(120)
  // Nulo = plaquinha impressa "em branco", aguardando configuração.
  destinationUrl String?             @map("destination_url") @db.VarChar(2048)
  // Nome do lote de impressão (agrupa plaquinhas geradas juntas).
  batchName      String?             @map("batch_name") @db.VarChar(80)
  active         Boolean             @default(true)
  notes          String?             @db.VarChar(2000)
  // Cliente revendedor dono desta plaquinha (nulo = só o dono do sistema mexe).
  clientId       String?             @map("client_id") @db.Uuid
  client         AdminUser?          @relation(fields: [clientId], references: [id], onDelete: SetNull)
  createdAt      DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime            @updatedAt @map("updated_at") @db.Timestamptz(3)
  changes        DestinationChange[]

  @@index([createdAt])
  @@index([active])
  @@index([batchName])
  @@index([clientId])
  @@map("plates")
}

model DestinationChange {
  id          String     @id @default(uuid()) @db.Uuid
  plateId     String     @map("plate_id") @db.Uuid
  plate       Plate      @relation(fields: [plateId], references: [id], onDelete: Cascade)
  previousUrl String?    @map("previous_url") @db.VarChar(2048)
  newUrl      String     @map("new_url") @db.VarChar(2048)
  changedAt   DateTime   @default(now()) @map("changed_at") @db.Timestamptz(3)
  // Quem fez a troca (nulo em registros antigos ou se a conta foi excluída).
  changedById String?    @map("changed_by_id") @db.Uuid
  changedBy   AdminUser? @relation(fields: [changedById], references: [id], onDelete: SetNull)

  @@index([plateId, changedAt])
  @@map("destination_changes")
}
