# Copie para .env em desenvolvimento. Em produção, configure estas variáveis no painel do Railway.
# NUNCA versione o arquivo .env.

# Conexão PostgreSQL. No Railway use a referência: ${{Postgres.DATABASE_URL}}
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/qrdin

# Origem pública usada nos QR Codes, sem barra final e sem caminho.
# ATENÇÃO: é o que fica impresso nas plaquinhas. Defina o domínio definitivo antes de imprimir.
APP_BASE_URL=http://localhost:3000

NODE_ENV=development
# O Railway define PORT automaticamente; não é preciso configurar lá.
PORT=3000

# Criação do primeiro administrador: usado apenas se ainda não existir nenhum.
# Depois do primeiro login, remova ADMIN_PASSWORD das variáveis.
ADMIN_EMAIL=voce@seudominio.com.br
ADMIN_PASSWORD=troque-por-uma-senha-longa-e-unica

# Opcionais
# SESSION_TTL_HOURS=12
# TRUST_PROXY=1
